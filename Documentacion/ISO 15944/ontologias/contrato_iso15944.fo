<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" xmlns:vf="https://w3id.org/valueflows/ont/vf#">
    <fo:layout-master-set>
        <fo:simple-page-master master-name="A4-Portrait" page-height="29.7cm" page-width="21.0cm" margin-top="2.0cm" margin-bottom="2.0cm" margin-left="2.0cm" margin-right="2.0cm">
            <fo:region-body margin-top="1.5cm" margin-bottom="1.5cm"/>
            <fo:region-before extent="1.2cm"/>
            <fo:region-after extent="1.0cm"/>
        </fo:simple-page-master>
    </fo:layout-master-set>
    <fo:page-sequence master-reference="A4-Portrait">
