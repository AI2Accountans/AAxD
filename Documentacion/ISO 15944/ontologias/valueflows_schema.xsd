<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://w3id.org/valueflows/ont/vf#"
           xmlns:vf="https://w3id.org/valueflows/ont/vf#"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <xs:annotation>
    <xs:documentation xml:lang="es">
      Esquema XML (XSD) oficial para la Ontología Valueflows (ISO/IEC 15944-4 / REA Architecture).
      Diseñado para captura de datos en Altova StyleVision, compilar formularios XForms, y canalización Shift Left a BaseX / DFRNT.
    </xs:documentation>
  </xs:annotation>

  <!-- =================================================================== -->
  <!-- TIPOS SIMPLE Y ENUMERACIONES (Semántica de Acciones REA)            -->
  <!-- =================================================================== -->

  <xs:simpleType name="ActionEnum">
    <xs:annotation>
      <xs:documentation>Verbos semánticos de acción en Valueflows/REA</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="transfer-complete"/>
      <xs:enumeration value="transfer-custody"/>
      <xs:enumeration value="transfer-rights"/>
      <xs:enumeration value="transfer"/>
      <xs:enumeration value="pay"/>
      <xs:enumeration value="produce"/>
      <xs:enumeration value="consume"/>
      <xs:enumeration value="use"/>
      <xs:enumeration value="work"/>
      <xs:enumeration value="cite"/>
      <xs:enumeration value="accept"/>
      <xs:enumeration value="modify"/>
      <xs:enumeration value="deliver-service"/>
      <xs:enumeration value="lower-intent"/>
      <xs:enumeration value="raise-intent"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AgentTypeEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Person"/>
      <xs:enumeration value="Organization"/>
      <xs:enumeration value="EcologicalAgent"/>
      <xs:enumeration value="SoftwareAgent"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- =================================================================== -->
  <!-- TIPOS COMPLEJOS REUTILIZABLES (Módulos de Valor)                     -->
  <!-- =================================================================== -->

  <!-- Estructura de Cantidad con Unidad de Medida (UOM) -->
  <xs:complexType name="MeasureType">
    <xs:sequence>
      <xs:element name="value" type="xs:decimal"/>
      <xs:element name="unitSymbol" type="xs:string" minOccurs="0"/>
      <xs:element name="unitURI" type="xs:anyURI" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="RelatedPartyTypeEnum">
    <xs:annotation>
      <xs:documentation>Clasificación de Partes Relacionadas (NIC 24 / IAS 24 / Precios de Transferencia)</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ParentCompany"/>
      <xs:enumeration value="Subsidiary"/>
      <xs:enumeration value="Associate"/>
      <xs:enumeration value="JointVenture"/>
      <xs:enumeration value="KeyManagementPersonnel"/>
      <xs:enumeration value="Affiliate"/>
      <xs:enumeration value="IndependentThirdParty"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Agente Económico (vf:Agent) -->
  <xs:complexType name="AgentType">
    <xs:sequence>
      <xs:element name="id" type="xs:string"/>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="agentType" type="vf:AgentTypeEnum" minOccurs="0"/>
      <xs:element name="isRelatedParty" type="xs:boolean" minOccurs="0"/>
      <xs:element name="relatedPartyType" type="vf:RelatedPartyTypeEnum" minOccurs="0"/>
      <xs:element name="primaryLocation" type="xs:string" minOccurs="0"/>
      <xs:element name="classifiedAs" type="xs:anyURI" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="note" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Especificación de Recurso (vf:ResourceSpecification) -->
  <xs:complexType name="ResourceSpecificationType">
    <xs:sequence>
      <xs:element name="id" type="xs:string"/>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="image" type="xs:anyURI" minOccurs="0"/>
      <xs:element name="defaultUnit" type="xs:string" minOccurs="0"/>
      <xs:element name="classifiedAs" type="xs:anyURI" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="note" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Recurso Económico (vf:EconomicResource) -->
  <xs:complexType name="EconomicResourceType">
    <xs:sequence>
      <xs:element name="id" type="xs:string"/>
      <xs:element name="name" type="xs:string" minOccurs="0"/>
      <xs:element name="conformsTo" type="xs:string" minOccurs="0"/>
      <xs:element name="accountingQuantity" type="vf:MeasureType" minOccurs="0"/>
      <xs:element name="onhandQuantity" type="vf:MeasureType" minOccurs="0"/>
      <xs:element name="currentLocation" type="xs:string" minOccurs="0"/>
      <xs:element name="containedIn" type="xs:string" minOccurs="0"/>
      <xs:element name="note" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Compromiso Económico (vf:Commitment) - Capa de Planificación / Shift Left -->
  <xs:complexType name="CommitmentType">
    <xs:sequence>
      <xs:element name="id" type="xs:string"/>
      <xs:element name="action" type="vf:ActionEnum"/>
      <xs:element name="provider" type="xs:string"/>
      <xs:element name="receiver" type="xs:string"/>
      <xs:element name="resourceConformsTo" type="xs:string" minOccurs="0"/>
      <xs:element name="resourceQuantity" type="vf:MeasureType" minOccurs="0"/>
      <xs:element name="effortQuantity" type="vf:MeasureType" minOccurs="0"/>
      <xs:element name="due" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="atLocation" type="xs:string" minOccurs="0"/>
      <xs:element name="clauseOf" type="xs:string" minOccurs="0"/>
      <xs:element name="reciprocalWith" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="state" type="xs:string" minOccurs="0"/>
      <xs:element name="note" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Hecho Económico Real (vf:EconomicEvent) - Capa de Observación -->
  <xs:complexType name="EconomicEventType">
    <xs:sequence>
      <xs:element name="id" type="xs:string"/>
      <xs:element name="action" type="vf:ActionEnum"/>
      <xs:element name="provider" type="xs:string"/>
      <xs:element name="receiver" type="xs:string"/>
      <xs:element name="resourceConformsTo" type="xs:string" minOccurs="0"/>
      <xs:element name="resourceQuantity" type="vf:MeasureType" minOccurs="0"/>
      <xs:element name="effortQuantity" type="vf:MeasureType" minOccurs="0"/>
      <xs:element name="hasPointInTime" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="start" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="hasEnd" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="atLocation" type="xs:string" minOccurs="0"/>
      <xs:element name="fulfills" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="realizes" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="note" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Acuerdo / Contrato Comercial (vf:Agreement) -->
  <xs:complexType name="AgreementType">
    <xs:sequence>
      <xs:element name="id" type="xs:string"/>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="created" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="specifiedIn" type="xs:anyURI" minOccurs="0"/>
      <xs:element name="buyer" type="vf:AgentType" minOccurs="0"/>
      <xs:element name="seller" type="vf:AgentType" minOccurs="0"/>
      <xs:element name="commitments" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="commitment" type="vf:CommitmentType" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="note" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Reclamación / Deuda derivada (vf:Claim) -->
  <xs:complexType name="ClaimType">
    <xs:sequence>
      <xs:element name="id" type="xs:string"/>
      <xs:element name="action" type="vf:ActionEnum"/>
      <xs:element name="provider" type="xs:string"/>
      <xs:element name="receiver" type="xs:string"/>
      <xs:element name="resourceQuantity" type="vf:MeasureType" minOccurs="0"/>
      <xs:element name="due" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="triggeredBy" type="xs:string" minOccurs="0"/>
      <xs:element name="settledBy" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- DUALIDAD / RECIPROCIDAD REA (ISO 15944-4) -->
  <xs:complexType name="ReciprocityType">
    <xs:sequence>
      <xs:element name="id" type="xs:string"/>
      <xs:element name="incrementCommitmentRef" type="xs:string"/>
      <xs:element name="decrementCommitmentRef" type="xs:string"/>
      <xs:element name="note" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- =================================================================== -->
  <!-- ELEMENTO RAÍZ COMPLETO PARA EL FORMULARIO EN STYLEVISION             -->
  <!-- =================================================================== -->

  <xs:element name="BusinessTransaction">
    <xs:annotation>
      <xs:documentation>
        Documento Raíz para la captura de Transacciones y Contratos ISO/IEC 15944-4 en Altova StyleVision.
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="transactionId" type="xs:string"/>
        <xs:element name="issueDate" type="xs:dateTime"/>
        <xs:element name="governingJurisdiction" type="xs:string" minOccurs="0"/>
        
        <!-- Contrato / Acuerdo -->
        <xs:element name="agreement" type="vf:AgreementType"/>
        
        <!-- Colección de Agentes Involucrados -->
        <xs:element name="agents" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="agent" type="vf:AgentType" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <!-- Catálogo de Especificaciones de Recursos -->
        <xs:element name="resourceSpecifications" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="resourceSpecification" type="vf:ResourceSpecificationType" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <!-- Colección de Compromisos (Planning Layer - REA) -->
        <xs:element name="commitments" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="commitment" type="vf:CommitmentType" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <!-- Enlaces de Reciprocidad entre Compromisos -->
        <xs:element name="reciprocities" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="reciprocity" type="vf:ReciprocityType" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <!-- Colección de Eventos Ejecutados (Observation Layer) -->
        <xs:element name="economicEvents" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="economicEvent" type="vf:EconomicEventType" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <!-- Colección de Reclamaciones / Deudas Pendientes -->
        <xs:element name="claims" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="claim" type="vf:ClaimType" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ELEMENTOS STANDALONE PARA MODELADO FLEXIBLE -->
  <xs:element name="Agreement" type="vf:AgreementType"/>
  <xs:element name="Commitment" type="vf:CommitmentType"/>
  <xs:element name="EconomicEvent" type="vf:EconomicEventType"/>
  <xs:element name="EconomicResource" type="vf:EconomicResourceType"/>
  <xs:element name="Agent" type="vf:AgentType"/>
  <xs:element name="Claim" type="vf:ClaimType"/>
  <xs:element name="ResourceSpecification" type="vf:ResourceSpecificationType"/>
  <xs:element name="Reciprocity" type="vf:ReciprocityType"/>

</xs:schema>