							<template subtype="xbrl-linkrole" match="https://xbrlsite.azurewebsites.net/mini/role/CashFlowStatement">
								<editorproperties label-lang="inherit" label-role="inherit" label-link-role="inherit"/>
								<children>
									<tgrid hidecols="when-body-empty" hiderows="when-body-empty" add-row-expand-collapse-buttons="1" add-column-close-buttons="1" tablegen-filter-periods-active-to="1" tablegen-filter-periods-to-month="12" tablegen-filter-periods-to-day="31" tablegen-div-monetary="0" wizard-used="1">
										<properties class="xbrl-table"/>
										<children>
											<tgridheader-cols>
												<children>
													<tgridcol/>
												</children>
											</tgridheader-cols>
											<tgridbody-cols>
												<children>
													<template subtype="xbrl-period" groupingtype="group-by" groupingmatch="if (altova-xfi:period-aspect-is-instant(.)) then 0 else if (altova-xfi:period-aspect-is-start-end(.)) then for $altova:duration in altova-xfi:period-aspect-end(.) - altova-xfi:period-aspect-start(.) return fn:years-from-duration($altova:duration) * 12 + fn:months-from-duration($altova:duration) + fn:ceiling(fn:days-from-duration($altova:duration) div 30 - 0.5) else 9999999999" filter="xs:date( ( xbrli:instant, xbrli:endDate ) ) &lt;= xs:date( &apos;2026-12-31&apos; )" tlb-behavior="open" show-instant-periods="0" show-forever-periods="0" closedmode-instant-datetime="2015-01-01T00:00:00" closedmode-duration-from-datetime="2015-01-01T00:00:00" closedmode-duration-to-datetime="2015-12-31T00:00:00" match="xbrli:period">
														<sort>
															<key match="current-grouping-key()" datatype="Number"/>
														</sort>
														<children>
															<template subtype="userdefined" match="current-group()">
																<sort>
																	<key match="if (altova-xfi:period-aspect-is-instant(.)) then concat(&apos;instant-&apos;, altova-xfi:period-aspect-instant(.)) else if (altova-xfi:period-aspect-is-start-end(.)) then concat(&apos;start-end-&apos;, altova-xfi:period-aspect-end(.)) else &apos;forever&apos;" order="descending"/>
																</sort>
																<children>
																	<tgridcol/>
																</children>
																<variables/>
															</template>
														</children>
														<variables/>
													</template>
												</children>
											</tgridbody-cols>
											<tgridheader-rows>
												<children>
													<tgridrow>
														<properties class="xbrl-row-header xbrl-row-level-0"/>
														<children>
															<tgridcell>
																<properties class="xbrl-cell xbrl-cell-table-title xbrl-col-odd xbrl-col-level-0"/>
																<children>
																	<text fixtext="1103 - Statement - Cash Flow Statement"/>
																</children>
															</tgridcell>
															<tgridcell>
																<properties class="xbrl-cell xbrl-cell-col-title-level-0 xbrl-cell-col-title xbrl-col xbrl-col-level-0"/>
																<children>
																	<condition>
																		<children>
																			<conditionbranch xpath="altova-xfi:period-aspect-is-instant($altova:CurrentXbrlConstraint_Period)">
																				<children>
																					<template subtype="xbrl-period-aspectvalue-instant" match="xbrl-period-instant">
																						<children>
																							<autocalc xpath="if (fn:hours-from-dateTime(.) eq 0 and fn:minutes-from-dateTime(.) eq 0 and fn:seconds-from-dateTime(.) eq 0) then xs:date(. - xs:dayTimeDuration(&apos;P1D&apos;)) else ."/>
																						</children>
																						<variables/>
																					</template>
																				</children>
																			</conditionbranch>
																			<conditionbranch xpath="altova-xfi:period-aspect-is-start-end($altova:CurrentXbrlConstraint_Period)">
																				<children>
																					<autocalc xpath="for $altova:duration in altova-xfi:period-aspect-end($altova:CurrentXbrlConstraint_Period) - altova-xfi:period-aspect-start($altova:CurrentXbrlConstraint_Period) return fn:years-from-duration($altova:duration) * 12 + fn:months-from-duration($altova:duration) + fn:ceiling(fn:days-from-duration($altova:duration) div 30 - 0.5)"/>
																					<text fixtext=" Months Ended"/>
																					<newline/>
																					<template subtype="xbrl-period-aspectvalue-enddate" match="xbrl-period-enddate">
																						<children>
																							<autocalc xpath="if (fn:hours-from-dateTime(.) eq 0 and fn:minutes-from-dateTime(.) eq 0 and fn:seconds-from-dateTime(.) eq 0) then xs:date(. - xs:dayTimeDuration(&apos;P1D&apos;)) else ."/>
																						</children>
																						<variables/>
																					</template>
																				</children>
																			</conditionbranch>
																			<conditionbranch xpath="altova-xfi:period-aspect-is-forever($altova:CurrentXbrlConstraint_Period)">
																				<children>
																					<text fixtext="forever"/>
																				</children>
																			</conditionbranch>
																		</children>
																	</condition>
																</children>
															</tgridcell>
														</children>
													</tgridrow>
												</children>
											</tgridheader-rows>
