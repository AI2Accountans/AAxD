					<vertex vertexkey="31"><edges><edge vertexkey="30"/></edges></vertex>
					<vertex vertexkey="35"><edges><edge vertexkey="34"/></edges></vertex>

					<!-- JSON-LD ISO15944_EconomicEvent connections -->
					<!-- Rows iteration drives JSON-LD item generation -->
					<vertex vertexkey="17"><edges><edge vertexkey="100"/></edges></vertex>
					<!-- rea:BusinessEventUUID → @id (EconomicEvent/) -->
					<vertex vertexkey="50"><edges><edge vertexkey="102"/></edges></vertex>
					<!-- local:BusinessEventLiteralDescription → eventDescription -->
					<vertex vertexkey="51"><edges><edge vertexkey="103"/></edges></vertex>
					<!-- rea:EventDate → eventDate -->
					<vertex vertexkey="11"><edges><edge vertexkey="104"/></edges></vertex>
					<!-- dca:EventType → dca_EventType -->
					<vertex vertexkey="55"><edges><edge vertexkey="105"/></edges></vertex>
					<!-- dca:Party → dca_Party -->
					<vertex vertexkey="52"><edges><edge vertexkey="106"/></edges></vertex>
					<!-- dca:Counterparty → dca_Counterparty -->
					<vertex vertexkey="53"><edges><edge vertexkey="107"/></edges></vertex>
					<!-- dca:Involves → dca_Involves -->
					<vertex vertexkey="56"><edges><edge vertexkey="108"/></edges></vertex>
					<!-- dca:RightOrObligation → dca_RightOrObligation -->
					<vertex vertexkey="57"><edges><edge vertexkey="109"/></edges></vertex>
					<!-- mini:BusinessEventCode → mini_BusinessEventCode -->
					<vertex vertexkey="31"><edges><edge vertexkey="110"/></edges></vertex>
					<!-- local:EntryIDLiteral → source_document (SourceDocument/ prefix) -->
					<vertex vertexkey="33"><edges><edge vertexkey="111"/><edge vertexkey="502"/><edge vertexkey="504"/></edges></vertex>
					<!-- local:EntryIDLiteral → entry_header -->
					<vertex vertexkey="33"><edges><edge vertexkey="112"/></edges></vertex>

					<!-- JSON-LD FIBO_StockCorporation connections -->
					<!-- rea:EconomicEntityIdentifier → identifierCode + @id -->
					<vertex vertexkey="21"><edges><edge vertexkey="202"/><edge vertexkey="204"/><edge vertexkey="205"/></edges></vertex>

					<!-- JSON-LD EntryDetail connections -->
					<!-- local:AccountLiteral → account @id + accountMainID -->
					<vertex vertexkey="12"><edges><edge vertexkey="403"/><edge vertexkey="605"/></edges></vertex>
					<!-- local:EntryIDLiteral → header + EntryHeader @id -->
					<vertex vertexkey="33"><edges><edge vertexkey="501"/><edge vertexkey="603"/></edges></vertex>
					<!-- local:SequenceLiteral → lineNumberCounter -->
					<vertex vertexkey="61"><edges><edge vertexkey="604"/></edges></vertex>
					<!-- xbrl:FactAmount → amount -->
					<vertex vertexkey="22"><edges><edge vertexkey="606"/></edges></vertex>
					<!-- local:Balance (D/C) → debitCreditCode -->
					<vertex vertexkey="15"><edges><edge vertexkey="607"/></edges></vertex>
					<!-- rea:EventDate → postingDate -->
					<vertex vertexkey="11"><edges><edge vertexkey="608"/><edge vertexkey="503"/></edges></vertex>
