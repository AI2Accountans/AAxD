					<vertex vertexkey="15"><edges><edge vertexkey="14"/></edges></vertex>
					<vertex vertexkey="17"><edges><edge vertexkey="16"/></edges></vertex>
					<vertex vertexkey="20"><edges><edge vertexkey="18"/></edges></vertex>
					<vertex vertexkey="21"><edges><edge vertexkey="19"/><edge vertexkey="27"/><edge vertexkey="204"/></edges></vertex>
