			<!-- ============================================================
			     GRAPH: Active connections CSV → XBRL GL + JSON-LD
			     Format: outkey (source CSV field) → inpkey (destination field)
			============================================================ -->
			<graph directed="1">
				<edges/>
				<vertices>
					<!-- XBRL GL connections (preserved from original) -->
					<vertex vertexkey="1"><edges><edge vertexkey="3"/><edge vertexkey="5"/></edges></vertex>
					<vertex vertexkey="23"><edges><edge vertexkey="6"/></edges></vertex>
					<vertex vertexkey="4"><edges><edge vertexkey="7"/></edges></vertex>
