<?xml version="1.0" encoding="UTF-8"?>
<!-- Edited with Altova MapForce 2024 -->
<!--
  BusinessEventLedger.mfd — Taller 1 (Hoffman Collaboration)
  MAPPING: CSV (Google Sheets) → XBRL GL 2015 + JSON-LD (OntologiaXBRLGL2JSONLD)
  Author: Richard Gasca / AI2Accountans — 2026
  
  ARCHITECTURE:
    Source:  CSV "Business Event Ledger" (Google Sheets / local file)
    Output1: XBRL GL 2015 (gl-plt-all-2015-03-25.xml)  — Capa Taxonómica
    Output2: OntologiaXBRLGL2JSONLD.json               — Capa Ontológica
    
  KEY CONNECTIONS (outkey→inpkey):
    CSV.Rows          → XBRL GL entryDetail (16→16)
    CSV.Rows          → JSON-LD ISO15944_EconomicEvent item (17→ISO15944)
    CSV.rea_EventDate → XBRL GL postingDate  (11→10)
    CSV.local_Account → XBRL GL accountMainID(12→8)
    CSV.xbrl_Amount   → XBRL GL amount       (22→9)
    CSV.local_Balance → XBRL GL debitCredit  (15→14)
    CSV.mini_BEC      → XBRL GL documentType (31→30)
    CSV.local_Comment → XBRL GL detailComment(35→34)
    CSV.local_EntryID → XBRL GL entryNumber  (33→28)
    CSV.dca_AuditRisk → XBRL GL qualifierEnt (32→29)
    CSV.rea_EntityID  → XBRL GL orgDesc      (21→27)
    CSV.xbrl_Decimals → XBRL GL decimals     (23→6)
    CSV.xbrl_Units    → XBRL currency unit   (via xbrl-measure-currency)
    
  JSON-LD CONNECTIONS:
    CSV.Rows (item iteration) drives all JSON-LD node generation
    Constant values injected for @type, @context, and URI construction
-->
<mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="25">
	<resources/>
	<component name="defaultmap" uid="1" editable="1" blackbox="0">
		<properties SelectedLanguage="builtin"/>
		<structure>
			<children>

				<!-- ============================================================
				     COMPONENT 2: OUTPUT — JSON-LD (Ontological Layer)
				     Schema: OntologiaXBRLGL2JSONLD.json (elevated Taller1 schema)
				============================================================ -->
				<component name="OntologiaXBRLGL2JSONLD" library="json" uid="2" kind="31">
					<properties XSLTTargetEncoding="UTF-8"/>
					<view ltx="1371" lty="13" rbx="1780" rby="900"/>
					<data>
						<root scrollposition="1">
							<header>
								<namespaces>
									<namespace/>
									<namespace uid="http://www.altova.com/mapforce"/>
								</namespaces>
							</header>
							<entry name="FileInstance" ns="1" expanded="1">
								<entry name="document" ns="1" expanded="1" casttotargettypemode="cast-in-subtree">
									<entry name="root" expanded="1">
										<entry name="array" expanded="1">
											<entry name="item" type="json-item" expanded="1" inpkey="100">
												<entry name="object" expanded="1">

													<!-- ISO15944_EconomicEvent — The HOLON root (Hoffman requirement) -->
													<entry name="anyOf_ISO15944_EconomicEvent" type="json-subtype" expanded="1">
														<entry name="@type" type="json-property" inpkey="101"/>
														<entry name="@id" type="json-property" inpkey="102"/>
														<entry name="eventDescription" type="json-property" inpkey="103"/>
														<entry name="eventDate" type="json-property" inpkey="104"/>
														<entry name="dca_EventType" type="json-property" inpkey="105"/>
														<entry name="dca_Party" type="json-property" inpkey="106"/>
														<entry name="dca_Counterparty" type="json-property" inpkey="107"/>
														<entry name="dca_Involves" type="json-property" inpkey="108"/>
														<entry name="dca_RightOrObligation" type="json-property" inpkey="109"/>
														<entry name="mini_BusinessEventCode" type="json-property" inpkey="110"/>
														<entry name="source_document" type="json-property" inpkey="111"/>
														<entry name="entry_header" type="json-property" inpkey="112"/>
													</entry>

													<!-- FIBO_StockCorporation — Reporting entity -->
													<entry name="anyOf_FIBO_StockCorporation" type="json-subtype" expanded="1">
														<entry name="@type" type="json-property" inpkey="201"/>
														<entry name="@id" type="json-property" inpkey="202"/>
														<entry name="artifact_name" type="json-property" inpkey="203"/>
														<entry name="identifierCode" type="json-property" inpkey="204"/>
														<entry name="identifierDescription" type="json-property" inpkey="205"/>
														<entry name="identifierType" type="json-property" inpkey="206"/>
													</entry>

													<!-- GistPerson — Economic Agent -->
													<entry name="anyOf_GistPerson" type="json-subtype" expanded="1">
														<entry name="@type" type="json-property" inpkey="301"/>
														<entry name="@id" type="json-property" inpkey="302"/>
														<entry name="identifierCode" type="json-property" inpkey="303"/>
														<entry name="identifierDescription" type="json-property" inpkey="304"/>
														<entry name="identifierType" type="json-property" inpkey="305"/>
													</entry>

													<!-- Account — Chart of Accounts with MINI bridge -->
													<entry name="anyOf_Account" type="json-subtype" expanded="1">
														<entry name="@type" type="json-property" inpkey="401"/>
														<entry name="@id" type="json-property" inpkey="402"/>
														<entry name="accountMainID" type="json-property" inpkey="403"/>
														<entry name="accountMainDescription" type="json-property" inpkey="404"/>
														<entry name="mainAccountType" type="json-property" inpkey="405"/>
														<entry name="mini_lineItem" type="json-property" inpkey="406"/>
													</entry>

													<!-- EntryHeader — XBRL GL entryHeader equivalent -->
													<entry name="anyOf_EntryHeader" type="json-subtype" expanded="1">
														<entry name="@type" type="json-property" inpkey="501"/>
														<entry name="@id" type="json-property" inpkey="502"/>
														<entry name="posting_date" type="json-property" inpkey="503"/>
														<entry name="source_document" type="json-property" inpkey="504"/>
														<entry name="economic_event" type="json-property" inpkey="505"/>
													</entry>

													<!-- EntryDetail — XBRL GL entryDetail + PROV-O (Momento1 elevation) -->
													<entry name="anyOf_EntryDetail" type="json-subtype" expanded="1">
														<entry name="@type" type="json-property" inpkey="601"/>
														<entry name="@id" type="json-property" inpkey="602"/>
														<entry name="header" type="json-property" inpkey="603"/>
														<entry name="lineNumberCounter" type="json-property" inpkey="604"/>
														<entry name="account" type="json-property" inpkey="605"/>
														<entry name="amount" type="json-property" inpkey="606"/>
														<entry name="debitCreditCode" type="json-property" inpkey="607"/>
														<entry name="postingDate" type="json-property" inpkey="608"/>
														<entry name="accountingPurposeCode" type="json-property" inpkey="609"/>
														<entry name="prov_generatedAtTime" type="json-property" inpkey="610"/>
														<entry name="agent" type="json-property" inpkey="611"/>
														<entry name="agent_identifier" type="json-property" inpkey="612"/>
														<entry name="duality" type="json-property" inpkey="613"/>
														<entry name="mini_lineItem" type="json-property" inpkey="614"/>
													</entry>

													<!-- ISO15944_Duality — REA Duality -->
													<entry name="anyOf_ISO15944_Duality" type="json-subtype" expanded="1">
														<entry name="@type" type="json-property" inpkey="701"/>
														<entry name="@id" type="json-property" inpkey="702"/>
														<entry name="triggerEvent" type="json-property" inpkey="703"/>
														<entry name="resultingEvent" type="json-property" inpkey="704"/>
													</entry>

												</entry>
											</entry>
										</entry>
									</entry>
								</entry>
							</entry>
						</root>
						<json schema="..\SchemaJsonLD\OntologiaXBRLGL2JSONLD.json" outputinstance="..\POC_Data_Example\BusinessEventLedger_JSONLD.jsonld"/>
					</data>
				</component>

				<!-- ============================================================
				     COMPONENT 5: OUTPUT — XBRL GL 2015 (Taxonomic Layer)
				============================================================ -->
