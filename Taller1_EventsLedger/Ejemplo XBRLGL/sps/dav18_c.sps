		<children>
			<globaltemplate subtype="named" match="ix_monetaryItemTypeNegative">
				<parameters/>
				<children>
					<condition>
						<children>
							<conditionbranch xpath="nilled(.)">
								<children>
									<content subtype="regular">
										<format basic-type="ixbrl" ixbrl-element="nonFraction" ixbrl-formatcode-ex="numcommadot" ixbrl-inputformat="#,##0.##########{sep=,,dec=.}"/>
									</content>
								</children>
							</conditionbranch>
							<conditionbranch xpath="number( . ) &gt;= 0">
								<children>
									<text fixtext="("/>
									<autocalc xpath="number( . )">
										<format basic-type="ixbrl" ixbrl-element="nonFraction" ixbrl-formatcode-ex="numcommadot" ixbrl-inputformat="#,##0.##########{sep=,,dec=.}" ixbrl-scale="6"/>
									</autocalc>
									<text fixtext=")"/>
								</children>
							</conditionbranch>
							<conditionbranch>
								<children>
									<autocalc xpath="number( . ) * -1">
										<format basic-type="ixbrl" ixbrl-element="nonFraction" ixbrl-formatcode-ex="numcommadot" ixbrl-inputformat="#,##0.##########{sep=,,dec=.}" ixbrl-scale="6"/>
									</autocalc>
								</children>
							</conditionbranch>
						</children>
					</condition>
				</children>
			</globaltemplate>
			<globaltemplate subtype="named" match="ix_monetaryItemType">
				<parameters/>
				<children>
					<condition>
						<children>
							<conditionbranch xpath="nilled(.)">
								<children>
									<content subtype="regular">
										<format basic-type="ixbrl" ixbrl-element="nonFraction" ixbrl-formatcode-ex="numcommadot" ixbrl-inputformat="#,##0.##########{sep=,,dec=.}"/>
									</content>
								</children>
							</conditionbranch>
							<conditionbranch xpath="number( . ) &gt;= 0">
								<children>
									<autocalc xpath="number( . )">
										<format basic-type="ixbrl" ixbrl-element="nonFraction" ixbrl-formatcode-ex="numcommadot" ixbrl-inputformat="#,##0.##########{sep=,,dec=.}" ixbrl-scale="6"/>
									</autocalc>
								</children>
							</conditionbranch>
							<conditionbranch>
								<children>
									<text fixtext="("/>
									<autocalc xpath="number( . ) * -1">
										<format basic-type="ixbrl" ixbrl-element="nonFraction" ixbrl-formatcode-ex="numcommadot" ixbrl-inputformat="#,##0.##########{sep=,,dec=.}" ixbrl-scale="6"/>
									</autocalc>
									<text fixtext=")"/>
								</children>
							</conditionbranch>
						</children>
					</condition>
				</children>
			</globaltemplate>
			<globaltemplate subtype="named" match="Template1">
				<parameters/>
				<children>
					<content subtype="regular">
						<format basic-type="xsd" string="Month DD&apos;,&apos; YYYY" datatype="date"/>
					</content>
				</children>
			</globaltemplate>
			<globaltemplate subtype="named" match="Qx">
				<parameters>
					<parameter name="Qx" type="xs:string" occurrence="none-or-one" default-value="&apos;&apos;"/>
				</parameters>
				<children>
					<content subtype="regular">
						<styles color="white" font-family="Arial" font-size="10pt" font-weight="bold"/>
						<format basic-type="xsd" string="Month{l} &apos; &apos; YYYY" datatype="date"/>
					</content>
				</children>
			</globaltemplate>
		</children>
	</designfragments>
