										<children>
											<text fixtext="£"/>
										</children>
									</conditionbranch>
									<conditionbranch xpath="fn:resolve-QName( text(), . ) eq fn:QName( &apos;http://www.xbrl.org/2003/iso4217&apos;, &apos;JPY&apos; )">
										<children>
											<text fixtext="¥"/>
										</children>
									</conditionbranch>
								</children>
							</condition>
						</children>
						<variables/>
					</template>
