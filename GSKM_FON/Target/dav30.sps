														<children>
															<autocalc xpath="number(//*[local-name()=&apos;Equity&apos; and @contextRef=&apos;ctx2&apos;]) - number(//*[local-name()=&apos;Equity&apos; and @contextRef=&apos;ctx1&apos;])">
																<styles font-family="Arial" font-size="11pt" font-weight="bold"/>
																<format basic-type="xsd" string="###,##0" datatype="decimal"/>
															</autocalc>
														</children>
													</tgridcell>
													<tgridcell>
														<styles text-align="right"/>
														<children>
															<autocalc xpath="format-number(
  (
    if (number(//*[local-name()=&apos;Equity&apos; and @contextRef=&apos;ctx1&apos;]) = 0) then
      (: El valor base (ctx1) es 0 :)
      (if (number(//*[local-name()=&apos;Equity&apos; and @contextRef=&apos;ctx2&apos;]) = 0) then 
         0  (: Si ambos son 0, la variación es 0 :)
       else 
         100 (: Si el base es 0 y el nuevo no, es 100 :)
      )
    else
      (: El valor base NO es 0, calcula normal :)
      round(
        (
          (
            number(//*[local-name()=&apos;Equity&apos; and @contextRef=&apos;ctx2&apos;]) - 
            number(//*[local-name()=&apos;Equity&apos; and @contextRef=&apos;ctx1&apos;])
          )
          div 
          number(//*[local-name()=&apos;Equity&apos; and @contextRef=&apos;ctx1&apos;])
        ) * 100
      , 2)
  ),
  &apos;#.00&apos;
)">
																<styles font-family="Arial" font-size="11pt"/>
																<format basic-type="ixbrl" ixbrl-element="nonFraction" ixbrl-formatcode-ex="numdot" ixbrl-inputformat="0.00########{sep=,,dec=.}" ixbrl-scale="3"/>
