																<styles font-family="Arial" font-size="11pt"/>
																<format basic-type="ixbrl" ixbrl-element="nonFraction" ixbrl-formatcode-ex="numdot" ixbrl-inputformat="0.00########{sep=,,dec=.}" ixbrl-scale="-2"/>
															</autocalc>
															<text fixtext=" %">
																<styles font-family="Arial" font-size="11pt"/>
															</text>
														</children>
													</tgridcell>
													<tgridcell>
														<styles text-align="right"/>
														<children>
															<autocalc xpath="number(//*[local-name()=&apos;OtrosGastosOperacionales&apos; and @contextRef=&apos;ctx3&apos;]) - number(//*[local-name()=&apos;OtrosGastosOperacionales&apos; and @contextRef=&apos;ctx4&apos;])">
																<styles font-family="Arial" font-size="11pt"/>
																<format basic-type="xsd" string="###,##0" datatype="decimal"/>
															</autocalc>
														</children>
													</tgridcell>
													<tgridcell>
														<styles text-align="right"/>
														<children>
															<autocalc xpath="format-number(
  (
    if (number(//*[local-name()=&apos;OtrosGastosOperacionales&apos; and @contextRef=&apos;ctx4&apos;]) = 0) then
      (: El valor base (ctx1) es 0 :)
      (if (number(//*[local-name()=&apos;OtrosGastosOperacionales&apos; and @contextRef=&apos;ctx3&apos;]) = 0) then 
         0  (: Si ambos son 0, la variación es 0 :)
       else 
         100 (: Si el base es 0 y el nuevo no, es 100 :)
      )
    else
      (: El valor base NO es 0, calcula normal :)
      round(
        (
          (
            number(//*[local-name()=&apos;OtrosGastosOperacionales&apos; and @contextRef=&apos;ctx3&apos;]) - 
            number(//*[local-name()=&apos;OtrosGastosOperacionales&apos; and @contextRef=&apos;ctx4&apos;])
          )
          div 
          number(//*[local-name()=&apos;OtrosGastosOperacionales&apos; and @contextRef=&apos;ctx4&apos;])
        ) * 100
      , 2)
  ),
  &apos;#.00&apos;
)">
																<styles font-family="Arial" font-size="11pt"/>
																<format basic-type="ixbrl" ixbrl-element="nonFraction" ixbrl-formatcode-ex="numdot" ixbrl-inputformat="0.00########{sep=,,dec=.}" ixbrl-scale="3"/>
															</autocalc>
															<text fixtext=" %">
																<styles font-family="Arial" font-size="11pt"/>
															</text>
														</children>
													</tgridcell>
												</children>
											</tgridrow>
