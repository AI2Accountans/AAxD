    "@value" : "Starting from leg 2 of a swap, fibo-fnd-acc-cur:hasNotionalAmount fibo-fnd-acc-cur:MonetaryAmount; fibo-fnd-acc-cur:hasAmount xsd:decimal"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
