  "http://purl.org/dc/terms/abstract" : [ {
    "@value" : "This ontology provides metadata about the FIBO Algorithmic Contract Types Unified Standards (ACTUS) Domain, which includes the ACTUS controlled vocabulary and maps it to FIBO, providing the corresponding semantics and enabling integration of knowledge graphs based on FIBO with the ACTUS system."
  } ],
