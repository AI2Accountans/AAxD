  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - CECV"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-CEGE",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Guaranteed Exposure"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "CEGE"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "Defines which value of the exposure is covered:\n\n- NO: Nominal Value\n\n- NI: Nominal plus Interest\n\n- MV: Market Value"
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Counterparty"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "guaranteedExposure"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - CEGE"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-CETC",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Credit Event Type Covered"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "CETC"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "The type of credit events covered e.g. in credit enhancement or credit default swap contracts. Only the defined credit event types may trigger the protection."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Counterparty"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "creditEventTypeCovered"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - CETC"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-CID",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Contract Identifier"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "CID"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "Unique identifier of a contract.\n\nIf the system is used on a single firm level, an internal unique ID can be generated. If used on a national or globally level, a globally unique ID is required."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-ContractIdentification"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "contractID"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - CID"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-CLA",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Credit Line Amount"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "CLA"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "If defined, gives the total amount that can be drawn from a credit line. The remaining amount that can still be drawn is given by CLA-NT.\n\nFor ANN, NAM, the credit line can only be drawn prior to PRANX-1PRCL.\n\nFor CRL, the remaining amount that can still be drawn is given by CLA-Sum(NT of attached contracts)."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "creditLineAmount"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - CLA"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-CLDR",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Calendar"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "CLDR"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "Calendar defines the non-working days which affect the dates of contract events (CDE's) in combination with EOMC and BDC. Custom calendars can be added as additional enum options."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Calendar"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "calendar"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - CLDR"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-CNTRL",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Contract Role"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "CNTRL"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "CNTRL defines which position the CRID ( the creator of the contract record ) takes in a contract. For example, whether the contract is an asset or liability, a long or short position for the CRID. \n\nMost contracts are simple on or off balance sheet positions which are assets, liabilities. Such contracts can also play a secondary role as a collateral. \n\nThe attribute is highly significant since it determines the direction of all cash flows. The exact meaning is given with each CT in the ACTUS High Level Specification document."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-ContractIdentification"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "contractRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - CNTRL"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-CPID",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Counterparty Identifier"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "CPID"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "CPID identifies the counterparty to the CRID in this contract.\n\nCPID is ideally the official LEI which can be a firm, a government body, even a single person etc. However, this can also refer to a annonymous group in which case this information is not to be disclosed. CPID may also refer to a group taking a joint risk or more generally, CPID is the main counterparty, against which the contract has been settled."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Counterparty"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "counterpartyID"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - CPID"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-CRID",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Creator Identifier"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "CRID"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "This identifies the legal entity creating the contract record. The counterparty of the contract is tracked in CPID.\n\nCRID is ideally the official LEI which can be a firm, a government body, even a single person etc. However, this can also refer to a annonymous group in which case this information is not to be disclosed. CRID may also refer to a group taking a joint risk."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-ContractIdentification"
