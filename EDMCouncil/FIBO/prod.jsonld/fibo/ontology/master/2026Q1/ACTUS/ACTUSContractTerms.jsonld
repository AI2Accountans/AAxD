}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-MRANX",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
