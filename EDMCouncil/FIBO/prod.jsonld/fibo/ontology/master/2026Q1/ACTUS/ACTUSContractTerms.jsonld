  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Margining"
