  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "BV"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "Boundary value in a barrier options contract, when reached, triggers the boundary effect specified e.g. Knock-In or Knock-out"
  } ],
