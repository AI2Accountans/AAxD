    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - PYRT"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-PYTP",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Penalty Type"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "PYTP"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "Defines whether prepayment is linked to a penalty and of which kind."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Optionality"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "penaltyType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - PYTP"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-QT",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Quantity"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "QT"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "This attribute relates either to physical contracts (COM) or underlyings of traded contracts. \n\nIn case of physical contracts it holds the number of underlying units of the specific good (e.g. number of barrels of oil). \n\nIn case of well defined traded contracts it holds the number of defined underlying instruments. Example: QT of STK CTs underlying a FUTUR indicates the number of those specific STK CTs which underlie the FUTUR."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "quantity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - QT"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRANX",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Cycle Anchor Date Of Rate Reset"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "RRANX"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "Date from which the rate reset date schedule is calculated according to the cycle length. The first rate reset event takes place on this anchor."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-RateReset"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "cycleAnchorDateOfRateReset"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - RRANX"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRCL",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Cycle Of Rate Reset"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "RRCL"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "Cycle according to which the rate reset date schedule will be calculated.\n\nIn case RRCL is not set, then there will only be one rate reset event at RRANX given RRANX if set.\n\nThe interval will be adjusted yet by EOMC and BDC."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-RateReset"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "cycleOfRateReset"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - RRCL"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRFIX",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Fixing Period"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "RRFIX"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "Interest rate resets (adjustments) are usually fixed one or two days (usually Business Days) before the new rate applies (defined by the rate reset schedule). This field holds the period between fixing and application of a rate."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-RateReset"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "fixingPeriod"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - RRFIX"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRLC",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Life Cap"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "RRLC"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "For variable rate basic CTs this represents a cap on the interest rate that applies during the entire lifetime of the contract.\n\nFor CAPFL CTs this represents the cap strike rate."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-RateReset"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "lifeCap"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - RRLC"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRLF",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Life Floor"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "RRLF"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "For variable rate basic CTs this represents a floor on the interest rate that applies during the entire lifetime of the contract.\n\nFor CAPFL CTs this represents the floor strike rate."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-RateReset"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "lifeFloor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - RRLF"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRMLT",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Rate Multiplier"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "RRMLT"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "Interest rate multiplier. A typical rate resetting rule is LIBOR plus x basis point where x represents the interest rate spread.\n\nHowever, in some cases like reverse or super floater contracts an additional rate multiplier applies. In this case, the new rate is determined as: IPNR after rate reset = Rate selected from the market object * RRMLT + RRSP."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-RateReset"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "rateMultiplier"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - RRMLT"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRMO",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Market Object Code Of Rate Reset"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "RRMO"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "Is pointing to the interest rate driver (MarketObject) used for rate reset uniquely.\n\nUnique codes for market objects must be used."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-RateReset"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "marketObjectCodeOfRateReset"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - RRMO"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRNXT",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Next Reset Rate"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "RRNXT"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "Holds the new rate that has been fixed already (cf. attribute FixingDays) but not applied. This new rate will be applied at the next rate reset event (after SD and according to the rate reset schedule). Attention, RRNXT must be set to NULL after it is applied!"
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-RateReset"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "nextResetRate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - RRNXT"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-RRPC",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Period Cap"
  } ],
