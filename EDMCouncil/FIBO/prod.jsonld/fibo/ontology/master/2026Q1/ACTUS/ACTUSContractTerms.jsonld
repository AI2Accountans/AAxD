    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-BMCL",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Boundary Monitoring Cycle"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "BMCL"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "The frequency with which boundary monitoring events occur. It defines how often the system checks to test whether the market value of the underlying asset has crossed the boundary in the specified direction triggerring a boundary crossing event."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Boundary"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "boundaryMonitoringCycle"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - BMCL"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-BMED",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
