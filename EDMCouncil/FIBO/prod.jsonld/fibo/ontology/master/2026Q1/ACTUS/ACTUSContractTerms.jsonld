    "@value" : "Cycle Anchor Date Of Fee"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "FEANX"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "Date from which the fee payment date schedule is calculated according to the cycle length. The first fee payment event takes place on this anchor."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Fees"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "cycleAnchorDateOfFee"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - FEANX"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-FEB",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Fee Basis"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "FEB"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "Basis, on which Fee is calculated. For FEB=’A’, FER is interpreted as an absolute amount to be paid at every FP event and for FEB=’N’, FER represents a rate at which FP amounts accrue on the basis of the contract’s NT."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Fees"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "feeBasis"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - FEB"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-FECL",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Cycle Of Fee"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "FECL"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "Defines in combination with FEANX the payment points of fees"
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Fees"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "cycleOfFee"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - FECL"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-FER",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Fee Rate"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "FER"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "Rate of Fee which is a percentage of the underlying or FER is an absolute amount. For all contracts where FEB does not apply (cf. business rules), FER is interpreted as an absolute amount."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Fees"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "feeRate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - FER"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
