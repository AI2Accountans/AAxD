}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-TD",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Termination Date"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "TD"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "If a contract is sold before MD (for example a bond on the secondary market) this date has to be set. It refers to the date at which the payment (of PTD) and transfer of the security happens. In other words, TD - if set - takes the role otherwise MD has from a cash flow perspective. \n\nNote, CPID of the CT is not the counterparty of the transaction!"
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "terminationDate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - TD"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-UT",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Unit"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "UT"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "The physical unit of the contract. Example: Barrels for an Oil COM CT."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "unit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - UT"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-XA",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Exercise Amount"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "XA"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "The amount fixed at Exercise Date for a contingent event/obligation such as a forward condition, optionality etc. The Exercise Amount is fixed at Exercise Date but not settled yet."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Settlement"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "exerciseAmount"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - XA"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-XD",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "Exercise Date"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "XD"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "Date of exercising a contingent event/obligation such as a forward condition, optionality etc. The Exercise date marks the observed timestamp of fixing the contingent event and respective payment obligation not necessarily the timestamp of settling the obligation."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-Settlement"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "exerciseDate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - XD"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm-XDN",
  "https://www.omg.org/spec/Commons/Designators/hasTextualName" : [ {
    "@value" : "X Day Notice"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasTag" : [ {
    "@value" : "XDN"
  } ],
  "https://www.omg.org/spec/Commons/Designators/hasDescription" : [ {
    "@value" : "Used as rolling attribute with the callable CT's UMP and CLM uniquely. CLM's and UMP's will not be settled (MD not set) until the client uses his option to call the contract X_Day_Notice after Current Date. As long as MD or TD is not set, the client postpones his right to call to the future. The cycle is normally defined in number of business days."
  } ],
  "https://www.omg.org/spec/Commons/Classifiers/isClassifiedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTermGroup-NotionalPrincipal"
  } ],
  "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/hasParameterName" : [ {
    "@value" : "xDayNotice"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTUS dictionary term - XDN"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/ACTUS/ACTUSContractTerms/ACTUSContractTerm"
  } ],
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
