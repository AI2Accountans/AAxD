  "http://purl.org/dc/terms/abstract" : [ {
    "@value" : "The functional entities module includes ontologies that define business entities according to their function as opposed to their form. They include service providers such as financial institutions (e.g., banks, investment companies, and insurance companies), government regulatory and registration agencies, as well as entities described in terms of their function in some process, such as clearing houses."
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/master/2026Q1/FBC/FunctionalEntities/MetadataFBCFunctionalEntities/"
  } ],
