  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "European Free Trade Association"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "intergovernmental organization of Iceland, Liechtenstein, Norway and Switzerland set up for the promotion of free trade and economic cooperation between its members, within Europe, and globally"
  } ],
  "https://www.omg.org/spec/Commons/AnnotationVocabulary/adaptedFrom" : [ {
