    "@id" : "https://ec.europa.eu/info/about-european-commission"
  } ],
  "https://www.omg.org/spec/Commons/AnnotationVocabulary/abbreviation" : [ {
    "@value" : "EC"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@value" : "The European Commission also plays a significant role in supporting international development and delivering aid."
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "supranational entity that helps to shape the EU's overall strategy, proposes new EU laws and policies, monitors their implementation and manages the EU budget"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/EuropeanJurisdiction/EUGovernmentEntitiesAndJurisdictions/"
