  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://www.omg.org/spec/Commons/RegulatoryAgencies/Jurisdiction" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "European Economic Area jurisdiction"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://ec.europa.eu/eurostat/statistics-explained/index.php?title=Glossary:European_Economic_Area_(EEA)",
    "@type" : "http://www.w3.org/2001/XMLSchema#anyURI"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "jurisdiction that consists of the member states of the European Union (EU) and three countries of the European Free Trade Association (EFTA) (Iceland, Liechtenstein and Norway; excluding Switzerland)"
  } ],
  "https://www.omg.org/spec/Commons/AnnotationVocabulary/abbreviation" : [ {
    "@value" : "EEA"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/EuropeanJurisdiction/EUGovernmentEntitiesAndJurisdictions/"
  } ],
  "https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote" : [ {
    "@value" : "The Agreement on the EEA entered into force on 1 January 1994. It seeks to strengthen trade and economic relations between the contracting parties and is principally concerned with the four fundamental pillars of the internal market, namely: the free movement of goods, people, services and capital. The availability of comparable statistical data is considered as relevant to the four freedoms and is therefore included in the agreement."
  } ]
