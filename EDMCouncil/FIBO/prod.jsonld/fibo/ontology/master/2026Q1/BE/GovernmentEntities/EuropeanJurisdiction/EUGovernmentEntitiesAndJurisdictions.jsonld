  "@type" : [ "https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/SupranationalEntity", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Council of Europe"
  } ],
  "https://www.omg.org/spec/Commons/AnnotationVocabulary/directSource" : [ {
    "@id" : "https://www.coe.int/en/web/portal/home"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "supranational entity founded in the wake of World War II to uphold human rights, democracy and the rule of law in Europe"
  } ],
  "https://www.omg.org/spec/Commons/AnnotationVocabulary/explanatoryNote" : [ {
    "@value" : "Founded in 1949, it has 46 member states, with a population of approximately 675 million; it operates with an annual budget of approximately 500 million euros."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/EuropeanJurisdiction/EUGovernmentEntitiesAndJurisdictions/"
  } ]
}, {
  "@id" : "https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/EuropeanJurisdiction/EUGovernmentEntitiesAndJurisdictions/EuropeanCommission",
