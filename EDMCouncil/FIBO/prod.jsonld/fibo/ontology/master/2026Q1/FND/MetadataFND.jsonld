  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Metadata for the FIBO Foundations (FND) Domain"
  } ],
  "http://purl.org/dc/terms/abstract" : [ {
    "@value" : "This ontology provides metadata about the FIBO Foundations (FND) domain area, which defines general purpose concepts supporting other domain areas of FIBO. The primary focus of Foundations is on agreements and contracts, their legal underpinnings, and related constructs."
  } ],
